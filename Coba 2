local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
local Window = Library.CreateLib("Sipalingjago Hub", "DarkTheme")

-- ==========================================
-- VARIABLE GLOBAL & LOGIKA UTAMA
-- ==========================================
_G.AutoFarmActive = false
_G.FarmRadius = 2 -- Nilai awal radius

local function CalculateGridArgument(position)
    local gridX = math.floor(position.X / 4.5 + 0.5)
    local gridY = math.floor(position.Y / 4.5 + 0.5)
    return Vector2.new(gridX, gridY)
end

local function GetSurroundingGrid(position, radius)
    local center = CalculateGridArgument(position)
    local areaTargets = {}
    for x = -radius, radius do
        for y = -radius, radius do
            table.insert(areaTargets, Vector2.new(center.X + x, center.Y + y))
        end
    end
    return areaTargets
end

local function ExecuteAutoFarm()
    local Character = game.Players.LocalPlayer.Character
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")
    if Root then
        -- Menggunakan nilai radius dari slider (_G.FarmRadius)
        local targets = GetSurroundingGrid(Root.Position, _G.FarmRadius)
        for _, targetGrid in ipairs(targets) do
            -- Berhenti memukul jika toggle dimatikan di tengah jalan
            if not _G.AutoFarmActive then break end
            game.ReplicatedStorage.Remotes.PlayerFist:FireServer(targetGrid)
        end
    end
end

-- ==========================================
-- BAGIAN UI (KAVO LIBRARY)
-- ==========================================

local Tab = Window:NewTab("Main Farm")
local Section = Tab:NewSection("Auto Farm Controls")

-- TOGGLE: Untuk ON/OFF
Section:NewToggle("Enable Auto Farm", "Mulai memukul otomatis", function(state)
    _G.AutoFarmActive = state
    
    if state then
        -- Menjalankan loop di thread terpisah agar UI tidak freeze
        task.spawn(function()
            while _G.AutoFarmActive do
                ExecuteAutoFarm()
                task.wait(0.1) -- Jeda agar tidak terkena ban/kick karena spam berlebih
            end
        end)
    end
end)

-- SLIDER: Untuk mengatur Radius (Jangkauan)
Section:NewSlider("Farm Radius", "Atur seberapa luas area pukulan", 10, 1, function(v)
    _G.FarmRadius = v
end)

-- BUTTON: Load script eksternal
Section:NewButton("Load External Script", "Menjalankan script GitHub", function()
    loadstring(game:HttpGet(("https://raw.githubusercontent.com/SIPALINGJAGOSc/Sipalingjago/refs/heads/main/farm")))()
end)

print("Sipalingjago Hub Sukses Dimuat!")
