local BG, DARK = Color3.fromRGB(30, 30, 36), Color3.fromRGB(50, 50, 58)
local ON, OFF = Color3.fromRGB(50, 180, 80), Color3.fromRGB(190, 60, 60)

local function round(obj, r)
	Instance.new("UICorner", obj).CornerRadius = UDim.new(0, r or 8)
end

local function newText(class, parent, size, pos, text, color)
	local o = Instance.new(class)
	o.Size, o.Position, o.Text = size, pos, text
	o.BackgroundColor3 = color or DARK
	o.TextColor3 = Color3.new(1, 1, 1)
	o.Font = Enum.Font.GothamBold
	o.TextSize = 14
	o.BorderSizePixel = 0
	o.Parent = parent
	round(o)
	return o
end

local panel = Instance.new("Frame")
panel.Size = UDim2.new(0, 210, 0, 236)
panel.Position = UDim2.new(1, -230, 0.5, -118)
panel.BackgroundColor3 = BG
panel.BorderSizePixel = 0
panel.Parent = gui
round(panel, 10)

-- Bar judul (untuk geser) + tombol minimize
