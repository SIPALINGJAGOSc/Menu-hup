-- === PENGATURAN ===
local cfg = {
	master = false,
	breakOn = true,
	collectOn = true,
	placeOn = false,
	range = 4,     -- 1..6 (6 = REACH server)
	delay = 0.25,  -- 0.1..1 (0.1 = COOLDOWN server)
}

-- === GUI ===
local gui = Instance.new("ScreenGui")
gui.Name = "AutoFarmGui"
gui.ResetOnSpawn = false
gui.DisplayOrder = 100
